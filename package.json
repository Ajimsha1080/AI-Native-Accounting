{
  "name": "ledger-ae-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:packages": "npm run build -w @ledger-ae/shared-types && npm run build -w @ledger-ae/uae-tax-engine && npm run build -w @ledger-ae/ledger-core && npm run build -w @ledger-ae/ubl-pinta-generator && npm run build -w @ledger-ae/mcp-server",
    "build": "npm run build:packages && npm run build -w @ledger-ae/web",
    "test": "npm run test --workspaces --if-present",
    "test:contract": "node --test packages/ledger-core/dist/integrations/contract-tests.test.js",
    "test:eval": "node scripts/run-ai-evals.mjs",
    "test:dr": "node scripts/dr/run-real-postgres-restore-drill.mjs",
    "test:load": "node scripts/run-1m-load-test.mjs",
    "lint": "node scripts/lint-zero-float-money.mjs && npm run lint --workspaces --if-present",
    "lint:money": "node scripts/lint-zero-float-money.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.7.3"
  }
}
