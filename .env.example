# ==============================================================================
# LedgerAE Environment Configuration Template
# All production secrets must be securely provided via environment management.
# Copy to .env.local or deploy via secret manager (AWS Secrets Manager / Vault).
# ==============================================================================

# Application & Runtime
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_LOCALE=en

# PostgreSQL Database (UAE Region, e.g. AWS me-central-1)
# Production MUST connect as a non-superuser role with FORCE ROW LEVEL SECURITY
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ledger_ae
POSTGRES_USER=ledger_app
POSTGRES_PASSWORD=replace_with_secure_postgres_password
DATABASE_URL=postgresql://ledger_app:replace_with_secure_postgres_password@localhost:5432/ledger_ae?sslmode=prefer

# Redis Cache & Distributed Lock
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_redis_password
REDIS_URL=redis://:replace_with_secure_redis_password@localhost:6379/0

# Authentication & Session Security (OWASP ASVS L2)
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace_with_at_least_32_byte_session_secret_base64
JWT_SECRET=replace_with_at_least_32_byte_jwt_secret_base64
SESSION_TTL_SECONDS=28800
TOTP_ENCRYPTION_KEY=replace_with_32_byte_hex_key_for_aes_gcm

# Temporal Durable Workflow Engine
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# MinIO / S3 Object Storage (10-Year Statutory UAE Tax Invoices)
S3_ENDPOINT=http://localhost:9000
S3_REGION=me-central-1
S3_BUCKET=ledger-ae-documents
S3_ACCESS_KEY=replace_with_minio_access_key
S3_SECRET_KEY=replace_with_minio_secret_key

# Anthropic Claude AI Integration
ANTHROPIC_API_KEY=replace_with_anthropic_api_key
ANTHROPIC_MODEL_ID=claude-3-7-sonnet-20250219

# UAE E-Invoicing Accredited Service Provider (ASP) Sandbox (PINT-AE)
ASP_PROVIDER_ID=PINT_AE_SANDBOX
ASP_API_URL=https://sandbox.asp.uae-einvoicing.ae/v1
ASP_CLIENT_ID=replace_with_asp_client_id
ASP_CLIENT_SECRET=replace_with_asp_client_secret
ASP_WEBHOOK_SECRET=replace_with_asp_webhook_hmac_secret

# UAE Open Banking Aggregator (Lean Technologies / Tarabut Gateway)
BANK_AGGREGATOR_PROVIDER=LEAN_TECHNOLOGIES
BANK_AGGREGATOR_API_KEY=replace_with_lean_api_key
BANK_AGGREGATOR_WEBHOOK_SECRET=replace_with_bank_webhook_secret

# Stripe Billing & Subscription Metering
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret

# Observability & Monitoring
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
